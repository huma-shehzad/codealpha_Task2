<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connectify | Register</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .auth-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            width: 100vw;
        }
        .auth-box {
            width: 100%;
            max-width: 400px;
            padding: 30px;
        }
        .auth-box h2 {
            margin-bottom: 20px;
            text-align: center;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .auth-box input {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            padding: 12px;
            margin-bottom: 15px;
            outline: none;
        }
        .auth-link {
            text-align: center;
            margin-top: 15px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }
        .auth-link a {
            color: #818cf8;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="glass-panel auth-box">
            <h2>Join Connectify ✨</h2>
            <% if (typeof error !== 'undefined') { %>
                <p style="color: #ef4444; font-size: 0.85rem; margin-bottom: 10px; text-align: center;"><%= error %></p>
            <% } %>
            <form action="/register" method="POST">
                <input type="text" name="username" placeholder="Username" required>
                <input type="email" name="email" placeholder="Email Address" required>
                <input type="password" name="password" placeholder="Password" required>
                <input type="text" name="avatar" placeholder="Avatar Image URL (Optional)">
                <button type="submit" class="btn-primary">Register</button>
            </form>
            <div class="auth-link">
                Already have an account? <a href="/login">Login here</a>
            </div>
        </div>
    </div>
</body>
</html>